<!-- ================= MODELS ================= -->
<section class="models" id="models" aria-label="Request models">
  <div class="wrap split">
    <div>
      <p class="eyebrow">Request models</p>
      <h2 class="h">Three ways to ask. One way to get it right.</h2>
      <p class="lede">The platform guides auditors toward the evidence model that fits the engagement.</p>
      <div class="tabs" role="tablist" aria-label="Confirmation models" id="tabs">
        <button class="tab" role="tab" id="tab0" aria-controls="panel" aria-selected="true" type="button"><b>Auditor-stated balance</b><span>The auditor enters the amount. The recipient confirms it or corrects it.</span></button>
        <button class="tab" role="tab" id="tab1" aria-controls="panel" aria-selected="false" tabindex="-1" type="button"><b>Blank confirmation</b><span>The recipient provides the balance directly from its own records.</span></button>
        <button class="tab" role="tab" id="tab2" aria-controls="panel" aria-selected="false" tabindex="-1" type="button"><b>Attachment-based</b><span>A client-generated document is attached as subject matter, not as the request.</span></button>
      </div>
    </div>
    <div class="preview" id="panel" role="tabpanel" aria-labelledby="tab0" aria-live="polite">
      <div id="sheetHost"></div>
      <p class="sheet-cap" id="sheetCap"></p>
    </div>
  </div>
</section>

<!-- ================= SIGNING CHAIN ================= -->
<section class="custody" id="custody" aria-labelledby="custody-title">
  <div class="wrap custody-layout">
    <figure class="custody-visual" id="custodyVisual" data-custody-step="0">
      <div class="custody-scene" aria-label="Three-dimensional signing and verification sequence">
        <div class="custody-assembly" aria-hidden="true">
          <div class="custody-base"><span>Signed confirmation record</span><b>MSQ-2026-0041</b></div>
          <article class="custody-document">
            <header><span>Audit confirmation</span><strong>CONFIRMED</strong></header>
            <h3>Bank balance confirmation</h3>
            <dl><div><dt>Requester</dt><dd>Verified</dd></div><div><dt>Responder</dt><dd>Verified</dd></div></dl>
            <div class="custody-rule"></div>
            <div class="custody-code"><img src="/assets/asset-3.svg" alt=""><span><small>Public validation</small><b>7F3A-C91E</b></span></div>
          </article>
          <div class="signature-token requester-token"><small>Requester</small><strong>Signed</strong><span>Document approved</span></div>
          <div class="signature-token responder-token"><small>Responder</small><strong>Confirmed</strong><span>Evidence attached</span></div>
          <div class="verification-plane"><span class="verification-mark"></span><div><small>Validation complete</small><strong>Record verified</strong></div></div>
          <div class="custody-beam beam-one"></div>
          <div class="custody-beam beam-two"></div>
        </div>
      </div>
      <div class="custody-controls" role="group" aria-label="Signing sequence">
        <button type="button" data-custody-target="0" aria-pressed="true"><span>Requester signs</span><small>Document approval</small></button>
        <button type="button" data-custody-target="1" aria-pressed="false"><span>Responder confirms</span><small>Decision and evidence</small></button>
        <button type="button" data-custody-target="2" aria-pressed="false"><span>Record validates</span><small>Public verification</small></button>
      </div>
      <figcaption>Illustrative signing sequence</figcaption>
    </figure>

    <div class="custody-copy">
      <h2 class="h" id="custody-title">Two signatures. One verifiable record.</h2>
      <p class="lede">Requester and responder actions converge on the same document, preserving identity, evidence and the final validation code.</p>
      <div class="custody-points">
        <p><strong>Signed in the browser</strong><span>Each party completes the action that belongs to its role.</span></p>
        <p><strong>Bound to the document</strong><span>Signatures remain with the exact confirmation version they approve.</span></p>
        <p><strong>Ready to validate</strong><span>The completed record can be checked through its verification code.</span></p>
      </div>
    </div>
  </div>
</section>

<!-- ================= TRACKING ================= -->
<section class="tracking" id="tracking" aria-label="Tracking">
  <div class="wrap">
    <p class="eyebrow">Tracking</p>
    <h2 class="h">Know where every request stands.</h2>
    <p class="lede">Six states, each with a clear meaning. A request moves between them as recipients respond, and nothing waits unseen past its due date.</p>
    <div class="status-explorer">
      <div class="stations-viewport" aria-label="Request status timeline">
        <div class="stations" id="stations">
          <div class="status-line" aria-hidden="true"><i class="status-line-fill"></i><i class="status-signal"></i></div>
          <button class="station" type="button" data-s="sent"><i class="sdot" aria-hidden="true"></i><b>Sent</b><span class="station-description sr">The request has gone to the recipient.</span><em class="station-count sr">212</em></button>
          <button class="station" type="button" data-s="pending"><i class="sdot" aria-hidden="true"></i><b>Pending</b><span class="station-description sr">Waiting, still within the due date.</span><em class="station-count sr">126</em></button>
          <button class="station" type="button" data-s="overdue"><i class="sdot" aria-hidden="true"></i><b>Overdue</b><span class="station-description sr">Past the due date. Follow-up needed.</span><em class="station-count sr">58</em></button>
          <button class="station" type="button" data-s="review"><i class="sdot" aria-hidden="true"></i><b>In review</b><span class="station-description sr">Response received and being checked.</span><em class="station-count sr">218</em></button>
          <button class="station" type="button" data-s="confirmed"><i class="sdot" aria-hidden="true"></i><b>Confirmed</b><span class="station-description sr">Completed, signed and on record.</span><em class="station-count sr">640</em></button>
          <button class="station" type="button" data-s="rejected"><i class="sdot" aria-hidden="true"></i><b>Rejected</b><span class="station-description sr">Declined or disputed by the recipient.</span><em class="station-count sr">30</em></button>
        </div>
      </div>
      <div class="status-detail" id="statusDetail" data-s="sent" role="status" aria-live="polite" aria-atomic="true">
        <div class="status-detail-copy"><span>Selected status</span><h3 id="statusDetailName">Sent</h3><p id="statusDetailDescription">The request has gone to the recipient.</p></div>
        <dl class="status-detail-data">
          <div><dt>Requests</dt><dd id="statusDetailCount">212</dd></div>
          <div><dt>Request reference</dt><dd>MSQ-2026-0038</dd></div>
        </dl>
      </div>
    </div>
    <div class="dist">
      <div class="dist-head"><h3>All requests this quarter</h3><strong>1,284</strong><span>Sample data</span></div>
      <div class="dist-bar" role="img" aria-label="Distribution: 640 confirmed, 218 in review, 212 sent, 126 pending, 58 overdue, 30 rejected">
        <i data-s="confirmed" style="width:49.8%"></i><i data-s="review" style="width:17%"></i><i data-s="sent" style="width:16.5%"></i><i data-s="pending" style="width:9.8%"></i><i data-s="overdue" style="width:4.5%"></i><i data-s="rejected" style="width:2.4%"></i>
      </div>
      <div class="dist-leg">
        <span data-s="confirmed">Confirmed <b>640</b></span><span data-s="review">In review <b>218</b></span><span data-s="sent">Sent <b>212</b></span><span data-s="pending">Pending <b>126</b></span><span data-s="overdue">Overdue <b>58</b></span><span data-s="rejected">Rejected <b>30</b></span>
      </div>
    </div>
  </div>
</section>

<!-- ================= CONTACT ================= -->
<section class="contact" id="contact" aria-labelledby="contact-title">
  <div class="wrap contact-grid">
    <div class="contact-copy">
      <p class="eyebrow">Contact us</p>
      <h2 class="h" id="contact-title">Bring clarity to your next confirmation cycle.</h2>
      <p class="lede">Tell us about your audit workflow, recipient volume, or integration needs. Our team will respond with the right next step.</p>
      <div class="contact-details">
        <div><span>Direct email</span><a href="mailto:<%= contactEmail %>"><%= contactEmail %></a></div>
        <div><span>Typical response</span><strong>Within one business day</strong></div>
      </div>
      <p class="contact-note">Your message is sent securely to the Musadaqat team.</p>
    </div>

    <form class="contact-form" id="contactForm" novalidate>
      <div class="form-grid">
        <div class="field">
          <label for="name">Full name</label>
          <input id="name" name="name" type="text" autocomplete="name" minlength="2" maxlength="80" required>
          <span class="field-error" id="nameError"></span>
        </div>
        <div class="field">
          <label for="email">Work email</label>
          <input id="email" name="email" type="email" autocomplete="email" maxlength="254" required>
          <span class="field-error" id="emailError"></span>
        </div>
        <div class="field">
          <label for="organization">Organization <span>Optional</span></label>
          <input id="organization" name="organization" type="text" autocomplete="organization" maxlength="120">
          <span class="field-error" id="organizationError"></span>
        </div>
        <div class="field">
          <label for="subject">How can we help?</label>
          <select id="subject" name="subject" required>
            <option value="">Choose an enquiry</option>
            <option>Request a demo</option>
            <option>Partnership</option>
            <option>Support</option>
            <option>General enquiry</option>
          </select>
          <span class="field-error" id="subjectError"></span>
        </div>
        <div class="field field-wide">
          <label for="message">Message</label>
          <textarea id="message" name="message" rows="6" minlength="20" maxlength="3000" placeholder="Share your confirmation workflow, timeline, or question." required></textarea>
          <span class="field-error" id="messageError"></span>
        </div>
      </div>
      <div class="hp" aria-hidden="true"><label for="website">Website</label><input id="website" name="website" type="text" tabindex="-1" autocomplete="off"></div>
      <input id="startedAt" name="startedAt" type="hidden">
      <div class="form-actions">
        <button class="btn btn-p btn-lg" id="contactSubmit" type="submit">Send message<svg class="arr" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 10h11M11 5l5 5-5 5"/></svg></button>
        <p class="form-status" id="formStatus" role="status" aria-live="polite"></p>
      </div>
    </form>
  </div>
</section>
</main>

<footer class="foot">
  <div class="wrap">
    <a href="#top" aria-label="Musadaqat"><img class="lg lg-l" src="/assets/asset-1.png" alt="Musadaqat مصادقات" width="133" height="30"><img class="lg lg-d" src="/assets/asset-2.png" alt="" aria-hidden="true" width="133" height="30"></a>
    <p>Digital Confirmation &amp; Audit Platform</p>
    <p>© 2026 Musadaqat</p>
  </div>
</footer>

