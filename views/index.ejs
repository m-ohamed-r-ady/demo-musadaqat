<!-- ================= HERO ================= -->
<section class="hero" id="hero" aria-label="Introduction">
  <div class="ledger" id="ledger" aria-hidden="true"></div>
  <div class="hero-in">
    <div class="hero-copy">
      <p class="eyebrow">Digital Confirmation &amp; Audit Platform</p>
      <h1><span>Trusted confirmation.</span><span class="m">Made simple.</span></h1>
      <p class="ar" lang="ar">مصادقة موثوقة. بكل بساطة.</p>
      <p class="lede">Secure, controlled and verifiable audit confirmations, from the first request to the signed record.</p>
      <div class="cta-row">
        <a class="btn btn-p btn-lg" id="heroCta" href="#contact">Request a demo<svg class="arr" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 10h11M11 5l5 5-5 5"/></svg></a>
        <a class="btn btn-o btn-lg" href="#story">See how it works</a>
        <button class="replay" id="replay" type="button"><svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 10a6 6 0 1 0 2-4.5M4 3v3.5h3.5"/></svg>Replay</button>
      </div>
    </div>
    <div class="hero-stage" id="heroStage" aria-hidden="true">
      <div class="persp">
        <div class="docwrap" id="heroWrap">
          <div class="ghost paper g2" id="hg2"></div>
          <div class="ghost paper g1" id="hg1"></div>
          <div data-slot="doc"></div>
        </div>
      </div>
      <ol class="rail" id="heroRail"><span class="fill"></span><li data-s="draft"><i></i>Draft</li><li data-s="sent"><i></i>Sent</li><li data-s="review"><i></i>In review</li><li data-s="confirmed"><i></i>Confirmed</li></ol>
      <p class="hero-state-note" id="heroStatus" aria-live="polite">Preparing the request</p>
    </div>
    <p class="sr">A confirmation request for Gulf Trading Co. moves from draft to sent, is reviewed, signed by the bank and marked confirmed.</p>
  </div>
</section>

<!-- ================= RECONCILIATION ================= -->
<section class="story" id="story" aria-labelledby="reconciliation-title">
  <div class="wrap recon-layout">
    <div class="recon-copy">
      <p class="eyebrow">Reconciliation</p>
      <h2 class="h" id="reconciliation-title"><span>Every response.</span><span>Every decision.</span><span>Accounted for.</span></h2>
      <p class="lede">Review the original request beside the recipient’s signed response, decision note and evidence—then preserve the full action history for the auditor.</p>
      <dl class="recon-facts">
        <div><dt>Responder decision</dt><dd>Confirm or reject with a recorded note</dd></div>
        <div><dt>Supporting record</dt><dd>Signed documents and optional evidence stay attached</dd></div>
        <div><dt>Final review</dt><dd>Confirmed responses route to the auditor for completion</dd></div>
      </dl>
    </div>

    <div class="recon-workspace" id="reconWorkspace" data-step="0" aria-label="Illustrative reconciliation workspace">
      <div class="recon-topbar">
        <div><span class="recon-kicker">Review workspace</span><strong>MSQ-2026-0087</strong></div>
        <span class="recon-sample">Illustrative record</span>
      </div>
      <div class="recon-switcher" role="group" aria-label="Workspace view">
        <button type="button" aria-pressed="true" data-recon-step="0">Original request</button>
        <button type="button" aria-pressed="false" data-recon-step="1">Recipient response</button>
        <button type="button" aria-pressed="false" data-recon-step="2">Auditor review</button>
      </div>

      <div class="recon-records">
        <article class="recon-record recon-request" aria-label="Original request record">
          <header><span class="record-index">01</span><div><small>Original request</small><h3>Request document</h3></div><span class="record-state">In progress</span></header>
          <dl class="record-meta">
            <div><dt>Requester</dt><dd>Crescent Retail</dd></div>
            <div><dt>Responder</dt><dd>Al Noor Distribution</dd></div>
            <div><dt>Contact branch</dt><dd>Riyadh Branch</dd></div>
            <div><dt>Document type</dt><dd>Trade receivable</dd></div>
          </dl>
          <div class="record-file"><span class="file-mark" aria-hidden="true">PDF</span><span><small>Main document</small><strong>confirmation-request.pdf</strong></span><em>Signed</em></div>
          <div class="record-note"><small>Additional note</small><p>Please review the attached confirmation request and supporting document.</p></div>
        </article>

        <div class="recon-link" aria-hidden="true"><span></span><i></i><span></span></div>

        <article class="recon-record recon-response" aria-label="Recipient response record">
          <header><span class="record-index">02</span><div><small>Recipient response</small><h3>Decision record</h3></div><span class="record-state is-confirmed">Confirmed</span></header>
          <dl class="record-meta">
            <div><dt>Responder</dt><dd>Al Noor Distribution</dd></div>
            <div><dt>Confirmation date</dt><dd>30 Jun 2026</dd></div>
            <div><dt>Decision</dt><dd>Confirmed</dd></div>
            <div><dt>Evidence</dt><dd>1 attachment</dd></div>
          </dl>
          <div class="record-file"><span class="file-mark" aria-hidden="true">PDF</span><span><small>Evidence document</small><strong>recipient-evidence.pdf</strong></span><em>Attached</em></div>
          <div class="record-note"><small>Decision note</small><p>Reviewed and confirmed against our records. Supporting evidence is attached.</p></div>
        </article>
      </div>

      <div class="recon-outcome" role="status" aria-live="polite">
        <span class="outcome-mark" aria-hidden="true"></span>
        <div><small>Ready for auditor review</small><strong>Response, evidence and action history are available together.</strong></div>
        <span class="outcome-state">Confirmed</span>
      </div>
    </div>
  </div>
</section>

<!-- ================= EVIDENCE STACK ================= -->
<section class="evidence" id="evidence" aria-labelledby="evidence-title">
  <div class="wrap evidence-layout">
    <div class="evidence-copy">
      <h2 class="h" id="evidence-title">A record built in layers.</h2>
      <p class="lede">Request data, documents, signatures and history remain connected, so the completed confirmation can be reviewed as one evidence package.</p>
      <dl class="evidence-facts">
        <div><dt>Request</dt><dd>The approved document and structured details establish what was sent.</dd></div>
        <div><dt>Evidence</dt><dd>Supporting files stay attached to the response they substantiate.</dd></div>
        <div><dt>History</dt><dd>Every decision and signature remains attributable in the final record.</dd></div>
      </dl>
    </div>

    <figure class="evidence-visual" id="evidenceVisual" data-evidence-layer="request">
      <div class="evidence-scene" aria-label="Exploded three-dimensional view of a confirmation evidence package">
        <div class="evidence-glow" aria-hidden="true"></div>
        <div class="evidence-stack" aria-hidden="true">
          <article class="evidence-layer evidence-history" data-layer="history">
            <div class="layer-head"><span>Action history</span><strong>5 events</strong></div>
            <div class="history-line"><i></i><span>Request created</span><time>09:14</time></div>
            <div class="history-line"><i></i><span>Sent to responder</span><time>09:34</time></div>
            <div class="history-line"><i></i><span>Response confirmed</span><time>11:08</time></div>
          </article>
          <article class="evidence-layer evidence-signatures" data-layer="signatures">
            <div class="layer-head"><span>Verified signatures</span><strong>2 parties</strong></div>
            <div class="signature-pair"><span><i>RQ</i><b>Requester</b><small>Signed</small></span><span><i>RS</i><b>Responder</b><small>Signed</small></span></div>
            <div class="signature-lock"><span></span>Identity and document version preserved</div>
          </article>
          <article class="evidence-layer evidence-attachments" data-layer="attachments">
            <div class="layer-head"><span>Supporting evidence</span><strong>Attached</strong></div>
            <div class="attachment-sheet"><i>PDF</i><span><b>recipient-evidence.pdf</b><small>Supporting document</small></span><em>1.2 MB</em></div>
            <div class="attachment-sheet secondary"><i>PDF</i><span><b>confirmation-request.pdf</b><small>Main document</small></span><em>Signed</em></div>
          </article>
          <article class="evidence-layer evidence-request is-active" data-layer="request">
            <div class="layer-head"><span>Confirmation request</span><strong>MSQ-2026-0087</strong></div>
            <h3>Trade receivable confirmation</h3>
            <dl><div><dt>Requester</dt><dd>Crescent Retail</dd></div><div><dt>Responder</dt><dd>Al Noor Distribution</dd></div><div><dt>As of date</dt><dd>30 Jun 2026</dd></div><div><dt>Status</dt><dd>Confirmed</dd></div></dl>
            <div class="request-seal"><span></span><b>Verified record</b></div>
          </article>
        </div>
        <div class="evidence-plinth" aria-hidden="true"><span>Musadaqat evidence package</span><b>MSQ-2026-0087</b></div>
      </div>
      <div class="evidence-controls" role="group" aria-label="Inspect evidence layers">
        <button type="button" data-evidence-target="request" aria-pressed="true">Request</button>
        <button type="button" data-evidence-target="attachments" aria-pressed="false">Evidence</button>
        <button type="button" data-evidence-target="signatures" aria-pressed="false">Signatures</button>
        <button type="button" data-evidence-target="history" aria-pressed="false">History</button>
      </div>
      <figcaption>Illustrative record using sample data</figcaption>
    </figure>
  </div>
</section>

<!-- ================= PRODUCT ================= -->
<section class="product" id="product" aria-label="The platform">
  <div class="wrap head">
    <div>
      <p class="eyebrow">The platform</p>
      <h2 class="h">Every confirmation, in one ledger.</h2>
    </div>
    <p class="lede">The request you just followed is the top row below. Status, reference, recipient and due date for each one, with the signed record a click away.</p>
